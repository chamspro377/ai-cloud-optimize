!terraform/docker/.terraform.lock.hcl

# Dataset paths are case-sensitive on Linux.
/ML/data/raw/
/ML/data/processed/
.ipynb_checkpoints/
/ML/README.md.txt
.env.*
*.pem
*.key
*.tfvars
*.tfvars.json
*.tfplan

# Trusted models required by Docker and inference (about 7 MB combined).
!/ML/models/reference_v1/cpu_reference.joblib
!/ML/models/reference_v1/mem_reference.joblib
